# Groq (OpenAI-compatible) — https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Same secret the SmartStock backend signs user tokens with
JWT_SECRET=

# The agent reads the account through the backend, as the signed-in user
BACKEND_URL=http://localhost:5050/api

# Conversations, long-term memories and feedback (database: SmartStockAI)
MONGO_URI=

ALLOWED_ORIGINS=http://localhost:5173
PORT=8000
