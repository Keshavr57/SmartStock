# Database
MONGO_URI=mongodb://localhost:27017/smartstock

# Authentication (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Server
PORT=5050
NODE_ENV=development
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# AI service base URL (only used by the keep-alive pinger; the client talks to it directly)
AI_SERVICE_URL=http://localhost:8000

# Reject orders outside NSE hours (9:15–15:30 IST, Mon–Fri). Off by default so the demo works anytime.
ENFORCE_MARKET_HOURS=false

# Optional market-data keys
INDIAN_API_KEY=
FMP_API_KEY=
